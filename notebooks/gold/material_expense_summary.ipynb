from pyspark.sql.functions import sum, current_timestamp, lit

job_id = dbutils.widgets.get("job_id")
job_run_id = dbutils.widgets.get("job_run_id")

df = (
    spark.table("silver.material_purchase")
    .groupBy("material_id")
    .agg(sum("total_cost").alias("total_material_expense"))
    .withColumn("create_date", current_timestamp())
    .withColumn("job_id", lit(job_id))
    .withColumn("job_run_id", lit(job_run_id))
)

df.write.mode("overwrite").format("delta").saveAsTable("gold.material_expense_summary")
