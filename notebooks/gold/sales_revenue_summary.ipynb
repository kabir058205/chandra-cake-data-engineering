df = (
    spark.table("silver.sales_orders")
    .groupBy("cake_type")
    .agg(sum("order_amount").alias("total_revenue"))
    .withColumn("create_date", current_timestamp())
    .withColumn("job_id", lit(job_id))
    .withColumn("job_run_id", lit(job_run_id))
)

df.write.mode("overwrite").format("delta").saveAsTable("gold.sales_revenue_summary")
